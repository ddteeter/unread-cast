# API Configuration
API_KEY=your-api-key-here
BASE_URL=https://your-domain.com

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Budget Configuration
MONTHLY_BUDGET_USD=50.00

# Server Configuration (optional)
PORT=8080
CRON_SCHEDULE=0 */6 * * *

# LLM Configuration (optional)
# Defaults: transcript on claude-sonnet-5, extraction on claude-haiku-4-5.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
#
# Available OpenAI models: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna, gpt-5.3, gpt-5.2, gpt-4o-mini
# Available Anthropic models: claude-opus-5, claude-sonnet-5, claude-opus-4-6,
#   claude-sonnet-4-5-20250929, claude-haiku-4-5
#
# Per-stage overrides. Transcript generation is short-input and long-output; HTML
# extraction is the opposite, so they can warrant different models.
# Note: GPT-5.6 Luna scores 41.3% on long-context recall (MRCR) against Terra's 89.6%,
# so it is a poor fit for extraction specifically.
#
# Resolution order for each stage: the per-stage variable, then LLM_MODEL if you set it,
# then the recommended pair above. Setting LLM_MODEL therefore applies it to BOTH stages
# - the extraction default only applies when you have pinned nothing. This keeps a
# provider switch coherent: LLM_PROVIDER=openai with LLM_MODEL=gpt-5.6-terra will not
# leave extraction pointed at a Claude model the OpenAI client cannot call.
# LLM_TRANSCRIPT_MODEL=claude-sonnet-5
# LLM_EXTRACTION_MODEL=claude-haiku-4-5
#
# Only applies to reasoning models (the gpt-5 family). Reasoning tokens bill as output
# tokens, so this is a cost lever as well as a quality one.
# LLM_REASONING_EFFORT=medium

# TTS Configuration (optional)
# Defaults to the 2025-12-15 snapshot, which reports ~35% lower word error rate than
# the previous generation at identical cost. Pin explicitly rather than using the
# floating `gpt-4o-mini-tts` alias so voice output does not change under you.
# Whatever you set must have a matching entry in pricing.json.
# TTS_MODEL=gpt-4o-mini-tts-2025-12-15
# TTS_VOICES=alloy,ash,ballad,coral,echo,fable,nova,onyx,sage,shimmer,verse

# Feed Configuration (optional)
# FEED_TITLE=Unread Cast
# FEED_AUTHOR=Unread Cast
# FEED_DESCRIPTION=Auto-generated podcasts from articles
# ARTWORK_URL=https://your-domain.com/artwork.jpg

# Data Management (optional)
# RETENTION_DAYS=90
# MIN_CONTENT_LENGTH=500
# DATA_DIR=/data
# PRICING_CONFIG_PATH=/data/pricing.json  # Checks /data first, falls back to /app/pricing.json

# Pushover Notifications (optional)
# PUSHOVER_USER_KEY=your-user-key
# PUSHOVER_APP_TOKEN=your-app-token

# Budget Warnings (optional)
# BUDGET_WARNING_PERCENT=80

# Processing Configuration (optional)
# MAX_RETRIES=5
